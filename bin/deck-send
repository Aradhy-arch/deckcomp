#!/usr/bin/env python3
"""
DeckComp CLI tool: Stage a file on Arch host for mobile phone download.
Usage: deck-send <file_path>
"""
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_PORT = int(os.environ.get("DECK_PORT", "8088"))
HOST_URL = f"http://127.0.0.1:{DEFAULT_PORT}/api/v1/share/stage"


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage: deck-send <path-to-file>")
        print("Stages a file on your Arch Linux host for your connected DeckComp phone.")
        sys.exit(0)

    target_path = Path(sys.argv[1]).resolve()
    if not target_path.exists():
        print(f"Error: File not found: {target_path}", file=sys.stderr)
        sys.exit(1)

    if not target_path.is_file():
        print(f"Error: Path is not a regular file: {target_path}", file=sys.stderr)
        sys.exit(1)

    payload = json.dumps({"path": str(target_path)}).encode("utf-8")
    headers = {"Content-Type": "application/json"}

    # Attach master auth token if available
    token = os.environ.get("DECK_AUTH_TOKEN")
    token_file = Path.home() / ".config" / "deckcomp" / "token"
    if not token_file.exists():
        token_file = Path.home() / ".config" / "deckcompanion" / "token"
    if not token and token_file.exists():
        try:
            token = token_file.read_text(encoding="utf-8").strip()
        except OSError:
            pass

    if token:
        headers["Authorization"] = f"Bearer {token}"

    req = urllib.request.Request(
        HOST_URL,
        data=payload,
        headers=headers
    )

    try:
        with urllib.request.urlopen(req, timeout=5) as response:
            res_data = json.loads(response.read().decode("utf-8"))
            filename = res_data.get("filename", target_path.name)
            size_kb = max(1, res_data.get("size_bytes", 0) // 1024)
            print(f"✓ Staged '{filename}' ({size_kb} KB) for mobile download.")
            print("  Open DeckComp on your phone to receive it.")
    except urllib.error.URLError as e:
        print(f"Error connecting to DeckComp daemon at {HOST_URL}: {e}", file=sys.stderr)
        print("Ensure 'systemctl --user status deckcomp.service' is running.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
